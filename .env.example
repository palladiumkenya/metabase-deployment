# ---- Metabase ----------------------------------------------------------
# Any tag from https://hub.docker.com/r/metabase/metabase/tags
# OSS tags look like v0.64.8 ; v0.64.x is the current LTS (EOL 2027-12-01).
METABASE_VERSION=v0.64.8
METABASE_PORT=3001
MB_SITE_URL=http://localhost:3001
JAVA_TIMEZONE=UTC

# ---- Application database (Postgres) -----------------------------------
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=postgres
MB_DB_PASS=metabase

# Parallel jobs for pg_restore (custom-format dumps only)
RESTORE_JOBS=2
